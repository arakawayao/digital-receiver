QWidget { background: #f3f5f7; color: #202733; font-family: "Segoe UI", "Microsoft YaHei UI"; font-size: 10pt; }
QMainWindow, QDialog { background: #f3f5f7; }
QMenuBar { background: #e8edf2; padding: 3px; }
QMenuBar::item { padding: 5px 12px; background: transparent; }
QMenuBar::item:selected, QMenu::item:selected { background: #cddfeb; }
QMenu { background: #ffffff; border: 1px solid #aeb9c6; padding: 5px; }
QMenu::item { padding: 7px 28px; }
QMenu::item:disabled { color: #7c8794; }
QMenu::separator { height: 1px; background: #d0d7df; margin: 5px 8px; }
QToolBar { background: #e8edf2; border: 0; border-bottom: 1px solid #c4ccd5; spacing: 7px; padding: 6px; }
QToolButton { padding: 6px; border: 1px solid transparent; border-radius: 3px; }
QToolButton:hover, QToolButton:checked { background: #d5e3ee; border-color: #9eb8ca; }
QPushButton { background: #ffffff; border: 1px solid #aeb9c6; border-radius: 3px; padding: 6px 12px; }
QPushButton:hover { background: #e8f3f7; border-color: #16849a; }
QPushButton:disabled, QToolButton:disabled { color: #9aa3ad; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox { background: #ffffff; border: 1px solid #aeb9c6; border-radius: 3px; padding: 5px; selection-background-color: #b8d9e2; }
QComboBox::drop-down { border: 0; width: 20px; }
QComboBox QAbstractItemView { background: #ffffff; selection-background-color: #b8d9e2; }
QGroupBox { border: 0; border-top: 1px solid #c8d0d8; margin-top: 18px; padding-top: 14px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; padding-right: 8px; }
QDockWidget { font-weight: 600; }
QDockWidget::title { background: #e1e7ed; padding: 7px; }
QTabWidget::pane { border: 1px solid #c4ccd5; }
QTabBar::tab { background: #e4e9ee; color: #5d6876; padding: 10px 18px; border-bottom: 2px solid transparent; }
QTabBar::tab:selected { color: #202733; border-bottom-color: #16849a; background: #f7f9fb; }
QTabBar::tab:hover { background: #d8e6ef; }
QPlainTextEdit, QTableWidget { background: #ffffff; border: 0; selection-background-color: #b8d9e2; gridline-color: #d8dee5; }
QHeaderView::section { background: #e8edf2; color: #536071; border: 0; padding: 7px; }
QStatusBar { background: #247a7f; color: #f1ffff; }
QStatusBar QLabel { background: transparent; color: #f1ffff; padding: 2px 6px; }
QLabel[role="muted"] { color: #697586; }
QLabel[role="value"] { font-size: 12pt; color: #202733; }
QLabel[role="signal"] { font-size: 24pt; font-weight: 600; color: #087d91; }
QLabel[role="brand"] { font-size: 13pt; font-weight: 600; padding-right: 12px; }
QLabel[role="warning"] { color: #a46100; }
QSplitter::handle { background: #d2d9e1; }
QScrollArea { border: 0; }
QScrollBar:vertical { background: #e8edf2; width: 10px; }
QScrollBar::handle:vertical { background: #aeb9c6; min-height: 24px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QSlider::groove:horizontal { height: 4px; background: #b9c4ce; }
QSlider::handle:horizontal { background: #16849a; width: 12px; margin: -5px 0; border-radius: 5px; }
QToolTip { background: #ffffff; color: #202733; border: 1px solid #8d9aaa; padding: 5px; }
