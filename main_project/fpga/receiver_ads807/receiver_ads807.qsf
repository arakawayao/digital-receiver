set_global_assignment -name FAMILY "Cyclone IV E"
# Inherited source-project target; verify the fitted device against the actual board.
set_global_assignment -name DEVICE EP4CE6F17C8
set_global_assignment -name TOP_LEVEL_ENTITY receiver_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 18.1.0
set_global_assignment -name VERILOG_INPUT_VERSION VERILOG_2001
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY ../../../.harness/receiver_ads807/quartus
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_parameter -name ADC_RATE 43500000
set_parameter -name OFFSET_BINARY 1
set_global_assignment -name VERILOG_FILE rtl/receiver_top.v
set_global_assignment -name VERILOG_FILE rtl/rx_capture.v
set_global_assignment -name VERILOG_FILE rtl/rx_frequency.v
set_global_assignment -name VERILOG_FILE rtl/rx_nco.v
set_global_assignment -name VERILOG_FILE rtl/rx_cic.v
set_global_assignment -name VERILOG_FILE rtl/rx_fir.v
set_global_assignment -name VERILOG_FILE rtl/rx_dsp.v
set_global_assignment -name VERILOG_FILE rtl/rx_reset.v
set_global_assignment -name VERILOG_FILE rtl/rx_packet.v
set_global_assignment -name VERILOG_FILE rtl/rx_fx2.v
set_global_assignment -name VERILOG_FILE ip/rx_pll_ads807.v
set_global_assignment -name VERILOG_FILE ip/rx_fifo.v
set_global_assignment -name VERILOG_FILE ip/rx_ifclk.v
set_global_assignment -name SDC_FILE receiver_ads807.sdc
source board_pins.tcl
set_instance_assignment -name VIRTUAL_PIN ON -to adc_data[0]
set_instance_assignment -name VIRTUAL_PIN ON -to adc_data[1]
set_instance_assignment -name VIRTUAL_PIN ON -to adc_data[2]
set_instance_assignment -name VIRTUAL_PIN ON -to adc_data[3]
set_instance_assignment -name VIRTUAL_PIN ON -to adc_data[4]
set_instance_assignment -name VIRTUAL_PIN ON -to adc_data[5]
set_instance_assignment -name VIRTUAL_PIN ON -to adc_data[6]
set_instance_assignment -name VIRTUAL_PIN ON -to adc_data[7]
set_instance_assignment -name VIRTUAL_PIN ON -to adc_data[8]
set_instance_assignment -name VIRTUAL_PIN ON -to adc_data[9]
set_instance_assignment -name VIRTUAL_PIN ON -to adc_data[10]
set_instance_assignment -name VIRTUAL_PIN ON -to adc_data[11]
set_instance_assignment -name VIRTUAL_PIN ON -to adc_clk

set_global_assignment -name LAST_QUARTUS_VERSION "18.1.0 Standard Edition"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top