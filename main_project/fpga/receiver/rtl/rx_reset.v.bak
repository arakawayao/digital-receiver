// Asynchronous assertion, synchronous release, then 32 startup clocks.
module rx_reset(input wire clk, input wire arst_n, output wire rst_n);
    (* altera_attribute = "-name SYNCHRONIZER_IDENTIFICATION FORCED" *)
    reg [1:0] sync;
    reg [5:0] wait_count;
    always @(posedge clk or negedge arst_n)
        if (!arst_n) begin sync <= 0; wait_count <= 0; end
        else begin
            sync <= {sync[0], 1'b1};
            if (!sync[1]) wait_count <= 0;
            else if (!wait_count[5]) wait_count <= wait_count + 1'b1;
        end
    assign rst_n = wait_count[5];
endmodule
