      "writes": [".harness/tri_board_test/ready.json", ".harness/tri_board_test/ready.tmp"],
      "timeout_seconds": 120
    },
    {
      "id": "receiver-replay-host-tests",
      "description": "43.5 MHz replay decoder, measurements, continuous bounded monitor and disconnect cleanup; requires NumPy/SciPy",
      "depends_on": [],
      "command": ["{python}", "-B", "-m", "unittest", "discover", "-s", "main_project/fpga/receiver_ads807/tests", "-p", "test_replay.py", "-v"],
      "writes": [],
      "timeout_seconds": 120
    },
    {
      "id": "receiver-replay-am",
      "description": "Intel IP/FX2 pin simulation: AM upload, RAM replay, IQ payload and production classifier",
      "depends_on": ["receiver-replay-host-tests"],
      "command": ["{python}", "-B", "main_project/fpga/receiver_ads807/scripts/replay_check.py", "am"],
      "writes": [".harness/receiver_replay/am/"],
      "timeout_seconds": 1500
    },
    {
      "id": "receiver-replay-fm",
      "description": "Intel IP/FX2 pin simulation: FM upload, RAM replay, IQ payload and production classifier",
      "depends_on": ["receiver-replay-host-tests"],
      "command": ["{python}", "-B", "main_project/fpga/receiver_ads807/scripts/replay_check.py", "fm"],
      "writes": [".harness/receiver_replay/fm/"],
      "timeout_seconds": 1500
    },
    {
