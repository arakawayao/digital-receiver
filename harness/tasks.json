      "description": "Compile GUI Windows .NET/Cypress receive worker; no hardware access",
      "depends_on": [],
      "command": ["{python}", "-B", "main_project/host/ads807/build_usb_pump.py"],
      "writes": ["main_project/host/.harness/ads807_host/managed/"],
      "timeout_seconds": 120
    },
    {
      "id": "ads807-host-portable-build",
      "description": "Build Windows x64 standalone host, load packaged native and managed libraries, verify synthetic GUI without USB or speakers; requires host build tools and Cypress SDK",
      "depends_on": ["ads807-host-tests"],
      "command": ["{python}", "-B", "main_project/host/tools/build_windows.py"],
      "writes": ["main_project/host/.harness/releases/", "main_project/host/.harness/pyinstaller_cache/", "main_project/host/.harness/ads807_host/managed/"],
