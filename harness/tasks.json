      "description": "Compile EP4CE6F17C8 replay SOF and verify device/PLL/multicorner STA; no programming",
      "depends_on": ["receiver-replay-am", "receiver-replay-fm"],
      "command": ["{python}", "-B", "main_project/fpga/receiver_ads807/scripts/replay_build.py"],
