      "command": ["{python}", "-B", "main_project/fpga/receiver_ads807_tri/scripts/build.py"],
      "writes": ["main_project/fpga/receiver_ads807_tri/", ".harness/receiver_ads807_tri/build/", ".harness/receiver_ads807_tri/quartus/"],
      "timeout_seconds": 2700
