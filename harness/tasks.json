{
  "version": 1,
  "tasks": [
    {
      "id": "ads807-am-restart-rtl",
      "description": "Actual FPGA estimator/control regression: continuous 50% AM STOP/retune/start, rejection cases and baseline frequency tests; no USB or programming",
      "depends_on": [],
      "command": ["{python}", "-B", "main_project/host/tests/fpga/run_am_restart.py", "--rtl-root", "main_project/fpga/receiver_ads807_dual"],
      "writes": ["main_project/host/.harness/am_restart_validation/"],
      "timeout_seconds": 300
    },
    {
      "id": "ads807-dual-control-tests",
      "description": "Offline dual control ACK, sequence, CRC and timeout checks; no USB access or programming",
      "depends_on": [],
      "command": ["{python}", "-B", "-m", "pytest", "main_project/host/tests/ads807/test_dual_control.py", "-q", "-p", "no:cacheprovider", "--basetemp", "main_project/host/.harness/ads807_host/pytest_dual_control"],
      "writes": ["main_project/host/.harness/ads807_host/pytest_dual_control/"],
      "timeout_seconds": 60
    },
    {
      "id": "receiver-ads807-dual-style",
      "description": "Two-mode hand-written HDL line declaration and assignment contract",
      "depends_on": [],
      "command": ["{python}", "-B", "main_project/fpga/receiver_ads807_dual/scripts/check_style.py"],
      "writes": [],
      "timeout_seconds": 60
    },
    {
      "id": "receiver-ads807-dual-cic-ip",
      "description": "Intel CIC R87 Hogenauer model, full-scale, impulse, random data and valid gaps; no hardware access",
      "depends_on": ["receiver-ads807-dual-style"],
      "command": ["{python}", "-B", "main_project/fpga/receiver_ads807_dual/scripts/cic_ip.py", "--pruned", "--skip-generate", "--simulate", "--installed"],
      "writes": [".harness/receiver_ads807_dual/cic_ip/"],
      "timeout_seconds": 600
    },
    {
      "id": "receiver-ads807-dual-fir-ip-evaluation",
      "description": "Isolated FIR II generation, bit-exact I/Q/reset warmup checks and EP4CE6 legacy/IP map-fit-STA comparison; no receiver integration or programming",
      "depends_on": ["receiver-ads807-dual-style"],
      "command": ["{python}", "-B", "main_project/fpga/receiver_ads807_dual/scripts/fir_ip.py", "--simulate", "--synthesize"],
      "writes": [".harness/receiver_ads807_dual/fir_ip/"],
      "timeout_seconds": 1800
    },
    {
      "id": "receiver-ads807-dual-reference",
      "description": "ADS807 capture/NCO, Intel pruned CIC and FIR versus independent fixed-point models",
      "depends_on": ["receiver-ads807-dual-cic-ip"],
      "command": ["{python}", "-B", "main_project/fpga/receiver_ads807_dual/scripts/dsp_reference.py"],
      "writes": [".harness/receiver_ads807_dual/reference/"],
      "timeout_seconds": 600
    },
    {
      "id": "receiver-ads807-dual-simulation",
      "description": "Two-mode ADC to actual Intel FIFO and FX2 pins; manual tuning, holdover, CRC, metadata and overflow",
      "depends_on": ["receiver-ads807-dual-reference", "ads807-host-tests"],
      "command": ["{python}", "-B", "main_project/fpga/receiver_ads807_dual/scripts/simulate.py"],
      "writes": [".harness/receiver_ads807_dual/simulation/"],
      "timeout_seconds": 1500
    },
    {
      "id": "receiver-ads807-dual-host-crosscheck",
      "description": "Production GUI decoder consumes actual two-mode FX2 RTL bytes with arbitrary chunking",
      "depends_on": ["receiver-ads807-dual-simulation"],
      "command": ["{python}", "-B", "main_project/fpga/receiver_ads807_dual/scripts/host_check.py"],
      "writes": [".harness/receiver_ads807_dual/simulation/host_crosscheck.json"],
      "timeout_seconds": 60
    },
    {
      "id": "receiver-ads807-dual-quartus",
      "description": "EP4CE6F17C8 two-mode map, fit and multicorner STA; virtual ADC, no programming",
      "depends_on": ["receiver-ads807-dual-host-crosscheck"],
      "command": ["{python}", "-B", "main_project/fpga/receiver_ads807_dual/scripts/build.py"],
      "writes": ["main_project/fpga/receiver_ads807_dual/", ".harness/receiver_ads807_dual/build/", ".harness/receiver_ads807_dual/quartus/"],
      "timeout_seconds": 2700
    },
    {
      "id": "tri-board-build-auto",
      "description": "Build fixed host-auto EP4CE6 TRI1 ROM cases; no USB access or programming",
      "depends_on": ["receiver-replay-host-tests"],
      "command": ["{python}", "-B", "main_project/fpga/receiver_ads807/scripts/tri_replay_build.py", "--mode", "auto"],
      "writes": [".harness/tri_board_test/auto/"],
      "timeout_seconds": 1200
    },
    {
      "id": "tri-board-build-manual",
      "description": "Build fixed manual EP4CE6 TRI1 ROM cases; no USB access or programming",
      "depends_on": ["receiver-replay-host-tests"],
      "command": ["{python}", "-B", "main_project/fpga/receiver_ads807/scripts/tri_replay_build.py", "--mode", "manual"],
      "writes": [".harness/tri_board_test/manual/"],
      "timeout_seconds": 1200
    },
    {
      "id": "tri-board-build-fpga",
      "description": "Prepare autonomous RPL1 cases from verified replay SOF; no USB access or programming",
      "depends_on": ["receiver-replay-build"],
      "command": ["{python}", "-B", "main_project/fpga/receiver_ads807/scripts/tri_replay_build.py", "--mode", "fpga"],
      "writes": [".harness/tri_board_test/fpga/"],
      "timeout_seconds": 120
    },
    {
      "id": "tri-board-check-auto",
      "description": "Intel IP and delayed FX2 simulation: ROM, ADC snapshot, DSP, TRI1 payload and small FM measurement",
      "depends_on": ["tri-board-build-auto"],
      "command": ["{python}", "-B", "main_project/fpga/receiver_ads807/scripts/tri_replay_check.py", "auto"],
      "writes": [".harness/tri_board_test/auto/"],
      "timeout_seconds": 1200
    },
    {
      "id": "tri-board-check-manual",
      "description": "Intel IP and delayed FX2 simulation for fixed manual ROM replay",
      "depends_on": ["tri-board-build-manual"],
      "command": ["{python}", "-B", "main_project/fpga/receiver_ads807/scripts/tri_replay_check.py", "manual"],
      "writes": [".harness/tri_board_test/manual/"],
      "timeout_seconds": 1200
    },
    {
